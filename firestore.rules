rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /gallery_projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /officers/{officerId} {
      allow read: if true;
      allow write: if false;
    }

    match /profiles/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.data.google_email == request.auth.token.email
        && request.resource.data.role == "Member"
        && request.resource.data.attended_ids.size() == 0;
      allow update: if isOwner()
        && request.resource.data.google_email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.attended_ids == resource.data.attended_ids;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
