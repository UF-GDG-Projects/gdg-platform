
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Events are publicly readable.
    // Client-side changes are not allowed.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Resources are publicly readable.
    // Client-side changes are not allowed.
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }

    // Each member can access only their own profile.
    match /profiles/{userId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function validName() {
        return request.resource.data.full_name is string
          && request.resource.data.full_name.size() > 0
          && request.resource.data.full_name.size() <= 120;
      }

      // Read your own profile.
      allow read: if isOwner();

      // Create a new profile after Google sign-in.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "full_name",
          "google_email",
          "profilepicture_url",
          "username",
          "role",
          "attended_ids",
          "major",
          "minor",
          "grad_semester",
          "created_at",
          "updated_at"
        ])
        && request.resource.data.keys().hasAll([
          "full_name",
          "google_email",
          "role",
          "attended_ids",
          "created_at",
          "updated_at"
        ])
        && validName()
        && request.resource.data.google_email
          == request.auth.token.email
        && request.resource.data.role == "member"
        && request.resource.data.attended_ids == []
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      // Members can edit personal information,
      // but cannot change roles or attendance records.
      allow update: if isOwner()
        && validName()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "full_name",
            "profilepicture_url",
            "major",
            "minor",
            "grad_semester",
            "updated_at"
          ])
        && request.resource.data.updated_at == request.time;

      // Members cannot delete their profile.
      allow delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
