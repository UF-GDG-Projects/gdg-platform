rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;

      match /checkins/{userId} {
        function signedInOwner() {
          return request.auth != null
            && request.auth.uid == userId;
        }

        function eventIsActive() {
          return exists(
            /databases/$(database)/documents/events/$(eventId)
          )
          && request.time >= get(
            /databases/$(database)/documents/events/$(eventId)
          ).data.starts_at
          && request.time <= get(
            /databases/$(database)/documents/events/$(eventId)
          ).data.ends_at;
        }

        allow get: if signedInOwner();
        allow list: if false;

        allow create: if signedInOwner()
          && exists(
            /databases/$(database)/documents/profiles/$(userId)
          )
          && eventIsActive()
          && request.resource.data.keys().hasOnly([
            "event_id",
            "user_id",
            "checked_in_at"
          ])
          && request.resource.data.keys().hasAll([
            "event_id",
            "user_id",
            "checked_in_at"
          ])
          && request.resource.data.event_id == eventId
          && request.resource.data.user_id == userId
          && request.resource.data.checked_in_at == request.time;

        allow update, delete: if false;
      }
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /gallery_projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /officers/{officerId} {
      allow read: if true;
      allow write: if false;
    }

    match /profiles/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.data.google_email == request.auth.token.email
        && (request.resource.data.role == "Member" || request.resource.data.role == "member")
        && request.resource.data.attended_ids.size() == 0;
      allow update: if isOwner()
        && request.resource.data.google_email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.attended_ids == resource.data.attended_ids;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
